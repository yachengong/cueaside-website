# Public product URLs
PUBLIC_SITE_URL=https://cueaside.com

# Supabase Auth and Postgres. The service role key is server-only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Enable only after each provider is configured in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

# Stripe test-mode values while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# OpenAI is server-side only. Never place this value in the macOS app.
OPENAI_API_KEY=sk-replace_me

# Deepgram is server-side only. It signs short-lived Nova-3 WebSocket tokens.
DEEPGRAM_API_KEY=replace_me

# Random server-only value used to pseudonymize OpenAI safety identifiers.
SAFETY_ID_SECRET=replace_with_a_long_random_value

# Optional comma-separated Supabase user IDs for owner/test access.
BILLING_BYPASS_USER_IDS=

# Server-only allowlist for the private /internal Console. This is deliberately
# separate from billing bypass and must contain Supabase auth user UUIDs.
CUEASIDE_ADMIN_USER_IDS=
