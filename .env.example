# Public product URLs
PUBLIC_SITE_URL=https://cueaside.com

# Supabase Auth. The anon key is used only to call Supabase Auth; the service
# role key is not required by CueAside.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me

# Stripe test-mode values while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# OpenAI is server-side only. Never place this value in the macOS app.
OPENAI_API_KEY=sk-replace_me

# Random server-only value used to pseudonymize OpenAI safety identifiers.
SAFETY_ID_SECRET=replace_with_a_long_random_value

# Optional comma-separated Supabase user IDs for owner/test access.
BILLING_BYPASS_USER_IDS=
